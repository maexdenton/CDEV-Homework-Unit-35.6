<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AwesomeNetwork</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/main-page.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/base-styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body class="background-main">
    <header class="border-bottom header background-white shadow-sm py-2">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- Логотип / Ссылка на главную -->
            <a class="navbar-brand font-weight-bold text-dark m-0" asp-area="" asp-controller="Home" asp-action="Index">
                SocialNetwork
            </a>

            <!-- Поиск + Кнопка Выход -->
            <partial name="_SearchLayoutPartial" />
        </div>
    </header>

    <div class="container background-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2021 - AwesomeNetwork - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Универсальный контейнер всплывающего окна уведомлений -->
    <div id="toastNotification" style="display: none; position: fixed; bottom: 25px; right: 25px; z-index: 999999; min-width: 320px; max-width: 380px; background: #ffffff; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.25); border-left: 6px solid #007bff; overflow: hidden; font-family: sans-serif;">
        <div style="padding: 10px 15px; background: #f8f9fa; border-bottom: 1px solid #eee; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center;">
                <img id="toastAvatar" src="/img/default_avatar.png" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover; margin-right: 8px;">
                <strong id="toastSender" style="color: #007bff; font-size: 14px;">Новое сообщение</strong>
            </div>
            <button type="button" onclick="document.getElementById('toastNotification').style.display='none';" style="background: none; border: none; font-size: 18px; cursor: pointer; color: #888;">&times;</button>
        </div>
        <div style="padding: 15px;">
            <p id="toastMessageText" style="margin: 0 0 12px 0; color: #333; font-size: 14px; word-break: break-word;"></p>
            <a id="toastChatLink" href="#" style="display: inline-block; background: #007bff; color: #fff; padding: 6px 14px; border-radius: 5px; text-decoration: none; font-size: 13px;">Перейти в диалог</a>
        </div>
    </div>

    <!-- Библиотеки -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    @if (User.Identity.IsAuthenticated)
    {
        <script>
            // Подключение к SignalR
            const hubConnection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            hubConnection.on("ReceiveNotification", function (senderName, messageText, senderId, senderAvatar) {
                console.log("Входящее сообщение от:", senderName, messageText);

                // Если мы уже открыли чат с этим отправителем — просто перезагружаем для показа сообщения
                if (window.location.href.indexOf("recipientId=" + senderId) !== -1) {
                    window.location.reload();
                    return;
                }

                // Заполняем всплывающее окно
                document.getElementById("toastSender").innerText = senderName;
                document.getElementById("toastMessageText").innerText = messageText.length > 60 ? messageText.substring(0, 60) + "..." : messageText;
                document.getElementById("toastAvatar").src = senderAvatar || "/img/default_avatar.png";
                document.getElementById("toastChatLink").href = "/Message/Chat?recipientId=" + senderId;

                // Показываем плашку
                const toast = document.getElementById("toastNotification");
                toast.style.display = "block";

                // Автоматически скрыть через 7 секунд
                setTimeout(() => {
                    toast.style.display = "none";
                }, 7000);
            });

            hubConnection.start()
                .then(() => console.log("✓ SignalR успешно подключен!"))
                .catch(err => console.error("✗ Ошибка подключения SignalR:", err.toString()));
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>
