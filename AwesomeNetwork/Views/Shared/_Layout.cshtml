<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AwesomeNetwork</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/main-page.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/base-styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body class="background-main">
    <header class="border-bottom header background-white">
        <div class="container">
            <div class="topnav">
                <a asp-area="" asp-controller="Home" asp-action="Index">SocialNetwork</a>
                <partial name="_SearchLayoutPartial" />
            </div>
        </div>
    </header>

    <div class="container background-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2021 - AwesomeNetwork - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Контейнер для всплывающих уведомлений (Toast) в правом нижнем углу -->
    <div aria-live="polite" aria-atomic="true" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;">
        <div id="toastNotification" class="toast hide shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-delay="6000" style="min-width: 300px; background-color: #fff; border-left: 5px solid #007bff; border-radius: 8px;">
            <div class="toast-header bg-white">
                <img id="toastAvatar" src="/img/default_avatar.png" class="rounded-circle mr-2 me-2" style="width: 25px; height: 25px; object-fit: cover;" onerror="this.src='/img/default_avatar.png';">
                <strong class="mr-auto me-auto text-primary" id="toastSender">Новое сообщение</strong>
                <small class="text-muted">только что</small>
                <button type="button" class="ml-2 ms-2 mb-1 close btn-close" data-dismiss="toast" data-bs-dismiss="toast" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="toast-body">
                <p id="toastMessageText" class="mb-2 text-dark"></p>
                <a id="toastChatLink" href="#" class="btn btn-sm btn-primary py-1 px-3">Ответить</a>
            </div>
        </div>
    </div>

    <!-- Базовые библиотеки скриптов -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
        <!-- Библиотека SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    @if (User.Identity.IsAuthenticated)
    {
        <script>
            // 1. Создаем подключение
            const hubConnection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            // 2. Обработчик входящего сообщения
            hubConnection.on("ReceiveNotification", function (senderName, messageText, senderId, senderAvatar) {
                console.log("Получено push-уведомление от:", senderName, messageText);

                // Если пользователь уже в чате с отправителем, просто обновляем страницу
                if (window.location.href.indexOf("recipientId=" + senderId) !== -1) {
                    window.location.reload();
                    return;
                }

                // Заполняем данные
                document.getElementById("toastSender").innerText = senderName;
                document.getElementById("toastMessageText").innerText = messageText.length > 50 ? messageText.substring(0, 50) + "..." : messageText;
                document.getElementById("toastAvatar").src = senderAvatar || "/img/default_avatar.png";
                document.getElementById("toastChatLink").href = "/Message/Chat?recipientId=" + senderId;

                // Универсальный показ уведомления (для Bootstrap 4 и Bootstrap 5)
                const toastEl = document.getElementById('toastNotification');
                
                try {
                    // Способ для Bootstrap 5
                    const bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
                    bsToast.show();
                } catch (e) {
                    // Запасной способ для Bootstrap 4 (jQuery)
                    $('#toastNotification').toast({ delay: 6000 }).toast('show');
                }
            });

            // 3. Запуск соединения
            hubConnection.start()
                .then(() => console.log("✓ SignalR успешно подключен!"))
                .catch(err => console.error("✗ Ошибка подключения SignalR:", err.toString()));
        </script>
    }

    <!-- Пользовательские скрипты из представлений (ТОЛЬКО ОДИН РАЗ В САМОМ КОНЦЕ) -->
    @RenderSection("Scripts", required: false)
</body>
</html>
