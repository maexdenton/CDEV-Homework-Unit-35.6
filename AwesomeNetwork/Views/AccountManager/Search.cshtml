@model AwesomeNetwork.ViewModels.Account.SearchViewModel
@{
    ViewData["Title"] = "Поиск пользователей";
}

<div class="container mt-4">
    <!-- Блок поиска -->
    <div class="card p-4 shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="mb-0">Поиск людей</h4>
            <a asp-action="MyPage" class="btn btn-outline-secondary btn-sm">В мой профиль</a>
        </div>
        
        <form method="get" asp-action="Search" class="d-flex mt-3">
            <!-- value сохраняет текст после отправки формы -->
            <input type="text" 
                   name="search" 
                   value="@Context.Request.Query["search"]" 
                   class="form-control me-2" 
                   placeholder="Введите имя или фамилию..." />
            <button type="submit" class="btn btn-primary ml-2 ms-2">Найти</button>
        </form>
    </div>

    <!-- Список найденных пользователей -->
    <div class="row">
        @if (!Model.UserList.Any())
        {
            <div class="col-12 text-center text-muted my-4">
                <p>Пользователи не найдены.</p>
            </div>
        }
        else
        {
            @foreach (var userExt in Model.UserList)
            {
                <div class="col-md-4 mb-4">
                    <div class="card p-3 shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                        <div>
                            <img src="@userExt.User.Image" 
                                 class="rounded-circle mx-auto mb-2" 
                                 style="width: 90px; height: 90px; object-fit: cover; border: 2px solid #e9ecef;" 
                                 onerror="this.src='/img/default_avatar.png';" 
                                 alt="Фото" />
                            
                            <h5 class="mt-2 mb-1">@userExt.User.GetFullName()</h5>
                            <p class="text-muted small">@(userExt.User.Status ?? "Нет статуса")</p>
                        </div>

                        <!-- Блок кнопок действий -->
                        <div class="mt-3 d-grid gap-2">
                            @if (userExt.IsFriendWithCurrent)
                            {
                                <form asp-action="DeleteFriend" method="post" class="mb-1">
                                    <input type="hidden" name="friendId" value="@userExt.User.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                        Удалить из друзей
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="AddFriend" method="post" class="mb-1">
                                    <input type="hidden" name="friendId" value="@userExt.User.Id" />
                                    <button type="submit" class="btn btn-sm btn-success w-100">
                                        Добавить в друзья
                                    </button>
                                </form>
                            }

                            <a asp-controller="Message" 
                               asp-action="Chat" 
                               asp-route-recipientId="@userExt.User.Id" 
                               class="btn btn-sm btn-outline-primary w-100">
                                Написать сообщение
                            </a>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</div>
