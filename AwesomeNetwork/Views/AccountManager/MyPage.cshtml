@model AwesomeNetwork.ViewModels.Account.UserViewModel
@{
    ViewData["Title"] = "Моя страница";
}

<div class="container mt-4">
    <div class="row">
        <!-- Карточка профиля слева -->
        <div class="col-md-4 text-center mb-4">
            <div class="card p-3 shadow-sm">
                <img src="@Model.User.Image" class="rounded-circle img-fluid mx-auto" 
                     style="width: 170px; height: 170px; object-fit: cover; border: 3px solid #007bff;" 
                     alt="Фото" 
                     onerror="this.src='/img/default_avatar.png';" />
                
                <h4 class="mt-3">@Model.User.GetFullName()</h4>
                <p class="text-muted">@(Model.User.Status ?? "Статус не указан")</p>
                
                <div class="d-grid gap-2 d-md-flex flex-column">
                    <a asp-action="Edit" class="btn btn-outline-primary btn-sm mb-2">Редактировать профиль</a>
                    <a asp-action="Search" class="btn btn-outline-success btn-sm">Найти друзей</a>
                </div>
            </div>
        </div>

        <!-- Информация, Диалоги и Друзья справа -->
        <div class="col-md-8">
            <div class="card p-4 shadow-sm mb-4">
                <h5>Информация</h5>
                <hr />
                <p><strong>Дата рождения:</strong> @(Model.User.BirthDate.HasValue ? Model.User.BirthDate.Value.ToString("dd.MM.yyyy") : "Не указана")</p>
                <p><strong>Email:</strong> @Model.User.Email</p>
                <p><strong>О себе:</strong> @(Model.User.About ?? "Информация отсутствует")</p>
            </div>

            <!-- Блок с вкладками -->
            <div class="card p-3 shadow-sm">
                <ul class="nav nav-tabs mb-3" id="profileTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active font-weight-bold" id="dialogs-tab" data-toggle="tab" href="#dialogs" role="tab">
                            Диалоги 
                            @if (Model.Conversations.Sum(c => c.UnreadCount) > 0)
                            {
                                <span class="badge badge-danger bg-danger text-white">@Model.Conversations.Sum(c => c.UnreadCount)</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="friends-tab" data-toggle="tab" href="#friends" role="tab">
                            Друзья (@Model.Friends.Count)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="followers-tab" data-toggle="tab" href="#followers" role="tab">
                            Подписчики (@Model.Followers.Count)
                        </a>
                    </li>
                </ul>

                <div class="tab-content" id="profileTabsContent">
                    <!-- Вкладка Диалоги -->
                    <div class="tab-pane fade show active" id="dialogs" role="tabpanel">
                        @if (!Model.Conversations.Any())
                        {
                            <p class="text-muted text-center py-3">У вас пока нет активных диалогов.</p>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var conv in Model.Conversations)
                                {
                                    <a asp-controller="Message" asp-action="Chat" asp-route-recipientId="@conv.Interlocutor.Id" 
                                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center mb-2 rounded border">
                                        <div class="d-flex align-items-center">
                                            <img src="@conv.Interlocutor.Image" class="rounded-circle mr-3 me-3" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.src='/img/default_avatar.png';" />
                                            <div>
                                                <h6 class="mb-0 font-weight-bold">@conv.Interlocutor.GetFullName()</h6>
                                                <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">
                                                    @(conv.LastMessage != null ? (conv.LastMessage.SenderId == Model.User.Id ? "Вы: " : "") + conv.LastMessage.Text : "Нет сообщений")
                                                </small>
                                            </div>
                                        </div>
                                        <div>
                                            @if (conv.UnreadCount > 0)
                                            {
                                                <span class="badge badge-pill badge-primary bg-primary text-white mr-2">+@conv.UnreadCount</span>
                                            }
                                            <small class="text-muted">@(conv.LastMessage?.Timestamp.ToString("dd.MM HH:mm"))</small>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    <!-- Вкладка Друзья -->
                    <div class="tab-pane fade" id="friends" role="tabpanel">
                        @if (!Model.Friends.Any())
                        {
                            <p class="text-muted text-center py-3">Список друзей пуст.</p>
                        }
                        else
                        {
                            <div class="row">
                                @foreach (var friend in Model.Friends)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                            <div class="d-flex align-items-center">
                                                <img src="@friend.Image" class="rounded-circle mr-2 me-2" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='/img/default_avatar.png';" />
                                                <span class="font-weight-bold">@friend.GetFullName()</span>
                                            </div>
                                            <div>
                                                <a asp-controller="Message" asp-action="Chat" asp-route-recipientId="@friend.Id" class="btn btn-sm btn-outline-primary">Чат</a>
                                                <form asp-action="DeleteFriend" method="post" class="d-inline">
                                                    <input type="hidden" name="friendId" value="@friend.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Вкладка Подписчики -->
                    <div class="tab-pane fade" id="followers" role="tabpanel">
                        @if (!Model.Followers.Any())
                        {
                            <p class="text-muted text-center py-3">Вас пока никто не добавил.</p>
                        }
                        else
                        {
                            <div class="row">
                                @foreach (var follower in Model.Followers)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                            <div class="d-flex align-items-center">
                                                <img src="@follower.Image" class="rounded-circle mr-2 me-2" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='/img/default_avatar.png';" />
                                                <span class="font-weight-bold">@follower.GetFullName()</span>
                                            </div>
                                            <div>
                                                <form asp-action="AddFriend" method="post" class="d-inline">
                                                    <input type="hidden" name="friendId" value="@follower.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success">В друзья</button>
                                                </form>
                                                <a asp-controller="Message" asp-action="Chat" asp-route-recipientId="@follower.Id" class="btn btn-sm btn-outline-primary">Чат</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
