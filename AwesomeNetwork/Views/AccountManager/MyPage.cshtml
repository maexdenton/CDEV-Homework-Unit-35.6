@model AwesomeNetwork.ViewModels.Account.UserViewModel
@{
    ViewData["Title"] = "Моя страница";
}

<div class="container mt-4">
    <div class="row">
        <!-- Левая колонка: Карточка профиля -->
        <div class="col-md-4 text-center">
            <div class="card p-3 shadow-sm">
                <img src="@Model.User.Image" class="rounded-circle img-fluid mx-auto" 
                     style="width: 180px; height: 180px; object-fit: cover; border: 3px solid #007bff;" 
                     alt="Фото пользователя" 
                     onerror="this.src='/img/default_avatar.png';" />
                
                <h4 class="mt-3">@Model.User.GetFullName()</h4>
                <p class="text-muted">@(Model.User.Status ?? "Статус не указан")</p>
                
                <div class="d-grid gap-2 d-md-flex flex-column">
                    <a asp-action="Edit" class="btn btn-outline-primary btn-sm mb-2">Редактировать профиль</a>
                    <a asp-action="Search" class="btn btn-outline-success btn-sm mb-2">Найти друзей</a>
                    
                    <!-- Кнопка выхода -->
                    <form asp-controller="AccountManager" asp-action="Logout" method="post" class="mt-1">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            Выйти из профиля
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Правая колонка: Информация и список друзей -->
        <div class="col-md-8">
            <!-- Блок информации -->
            <div class="card p-4 shadow-sm mb-4">
                <h5>Информация</h5>
                <hr />
                <p><strong>Дата рождения:</strong> @(Model.User.BirthDate.HasValue ? Model.User.BirthDate.Value.ToString("dd.MM.yyyy") : "Не указана")</p>
                <p><strong>Email:</strong> @Model.User.Email</p>
                <p><strong>О себе:</strong> @(Model.User.About ?? "Информация отсутствует")</p>
            </div>

            <!-- Список друзей -->
            <div class="card p-4 shadow-sm">
                <h5>Мои друзья (@Model.Friends.Count)</h5>
                <hr />
                @if (!Model.Friends.Any())
                {
                    <p class="text-muted">У вас пока нет друзей.</p>
                }
                else
                {
                    <div class="row">
                        @foreach (var friend in Model.Friends)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="d-flex align-items-center justify-content-between p-2 border rounded">
                                    <div class="d-flex align-items-center">
                                        <img src="@friend.Image" class="rounded-circle mr-2 me-2" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.src='/img/default_avatar.png';" />
                                        <span class="ml-2 ms-2 font-weight-bold">@friend.GetFullName()</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <!-- Кнопка перехода в чат -->
                                        <a asp-controller="Message" asp-action="Chat" asp-route-recipientId="@friend.Id" class="btn btn-sm btn-outline-primary mr-1 me-1">
                                            Чат
                                        </a>
                                        <!-- Кнопка удаления из друзей -->
                                        <form asp-action="DeleteFriend" method="post" class="d-inline m-0">
                                            <input type="hidden" name="friendId" value="@friend.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
